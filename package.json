{
  "name": "photos",
  "productName": "Photos",
  "version": "0.1.0",
  "description": "A native photo library for Windows, macOS, and Linux. Originals stay untouched.",
  "main": "out/main/index.js",
  "author": "SatyaKesava",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SatyaKesavaKorlapati/Photos.git"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.satyakesava.photos",
    "productName": "Photos",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["out/**/*", "build/icon.png", "package.json"],
    "asarUnpack": ["node_modules/@ffmpeg-installer/**", "node_modules/ffprobe-static/**", "node_modules/sharp/**", "node_modules/@img/**"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "extraResources": [{ "from": "vendor/ffmpeg", "to": "ffmpeg", "filter": ["ffmpeg.exe", "ffprobe.exe"] }],
      "fileAssociations": [
        { "ext": ["jpg", "jpeg", "png", "heic", "heif", "gif", "webp", "tif", "tiff", "dng", "avif"], "name": "Photo", "description": "Photo", "role": "Viewer" },
        { "ext": ["mp4", "mov", "m4v", "webm"], "name": "Video", "description": "Video", "role": "Viewer" }
      ]
    },
    "nsis": {
      "artifactName": "Photos-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Photos",
      "uninstallDisplayName": "Photos"
    },
    "portable": { "artifactName": "Photos-${version}-portable.${ext}" },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "category": "public.app-category.photography",
      "identity": null
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Photography",
      "artifactName": "Photos-${version}-${arch}.${ext}",
      "fileAssociations": [
        { "ext": ["jpg", "jpeg", "png", "heic", "heif", "gif", "webp", "tif", "tiff", "dng", "avif"], "name": "Photo", "description": "Photo" },
        { "ext": ["mp4", "mov", "m4v", "webm"], "name": "Video", "description": "Video" }
      ]
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "exifr": "^7.1.3",
    "ffprobe-static": "^3.1.0",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.5"
  }
}
